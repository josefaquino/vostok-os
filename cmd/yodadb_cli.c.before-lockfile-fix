#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <sys/file.h>
#include <time.h>
#include "kyber_btree.h"

#define MAGIC_BYTE 0xAA
#define HEADER_SIZE 18
#define BLOOM_SIZE (256 * 1024 * 1024)

/* ═══ Estrutura do YodaDB em C ═══ */
typedef struct {
    int storage_fd;
    int bloom_fd;
    uint8_t *bloom;
    KyberBTree *kyber;
    int64_t current_offset;
    int lock_fd;
    uint64_t ingested;
    char storage_path[1024];
    char kyber_path[1024];
} YodaDB;

/* ═══ Funções auxiliares ═══ */
static void write_u64_be(uint8_t *p, uint64_t v) {
    p[0] = (v >> 56) & 0xFF; p[1] = (v >> 48) & 0xFF;
    p[2] = (v >> 40) & 0xFF; p[3] = (v >> 32) & 0xFF;
    p[4] = (v >> 24) & 0xFF; p[5] = (v >> 16) & 0xFF;
    p[6] = (v >> 8) & 0xFF;  p[7] = v & 0xFF;
}

static uint64_t read_u64_be(const uint8_t *p) {
    return ((uint64_t)p[0] << 56) | ((uint64_t)p[1] << 48) |
           ((uint64_t)p[2] << 40) | ((uint64_t)p[3] << 32) |
           ((uint64_t)p[4] << 24) | ((uint64_t)p[5] << 16) |
           ((uint64_t)p[6] << 8)  | (uint64_t)p[7];
}

static void write_u32_be(uint8_t *p, uint32_t v) {
    p[0] = (v >> 24) & 0xFF; p[1] = (v >> 16) & 0xFF;
    p[2] = (v >> 8) & 0xFF;  p[3] = v & 0xFF;
}

static uint32_t read_u32_be(const uint8_t *p) {
    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
           ((uint32_t)p[2] << 8) | (uint32_t)p[3];
}


/* ═══ File Locking (flock) ═══ */
static int yodadb_lock(YodaDB *db) {
    db->lock_fd = open(db->storage_path, O_RDWR);
    if (db->lock_fd < 0) {
        fprintf(stderr, "❌ Falha ao abrir arquivo para lock\n");
        return -1;
    }
    
    if (flock(db->lock_fd, LOCK_EX) != 0) {
        fprintf(stderr, "❌ Falha ao adquirir lock\n");
        close(db->lock_fd);
        return -1;
    }
    
    return 0;
}

static void yodadb_unlock(YodaDB *db) {
    if (db->lock_fd >= 0) {
        flock(db->lock_fd, LOCK_UN);
        close(db->lock_fd);
        db->lock_fd = -1;
    }
}
/* ═══ Abrir YodaDB ═══ */
static YodaDB* yodadb_open(const char *storage_path) {
    YodaDB *db = calloc(1, sizeof(YodaDB));
    if (!db) return NULL;
    
    strncpy(db->storage_path, storage_path, sizeof(db->storage_path) - 1);
    snprintf(db->kyber_path, sizeof(db->kyber_path), "%s.kyber", storage_path);
    
    /* Abrir storage */
    db->storage_fd = open(storage_path, O_RDWR | O_CREAT, 0644);
    if (db->storage_fd < 0) {
        perror("open storage");
        free(db);
        return NULL;
    }
    
    /* Mover para o final */
    db->current_offset = lseek(db->storage_fd, 0, SEEK_END);
    
    if (yodadb_lock(db) != 0) {
        kyber_btree_close(db->kyber);
        close(db->storage_fd);
        free(db);
        return NULL;
    }
    
    /* Abrir KyberDB */
    KyberBTreeConfig cfg = { .use_wal = true };
    db->kyber = kyber_btree_open(db->kyber_path, &cfg);
    if (!db->kyber) {
        fprintf(stderr, "❌ Falha ao abrir KyberDB: %s\n", kyber_btree_last_error());
        close(db->storage_fd);
        free(db);
        return NULL;
    }
    
    return db;
}

/* ═══ Fechar YodaDB ═══ */
static void yodadb_close(YodaDB *db) {
    if (!db) return;
    yodadb_unlock(db);
    if (db->kyber) kyber_btree_close(db->kyber);
    if (db->storage_fd >= 0) close(db->storage_fd);
    if (db->bloom_fd >= 0) close(db->bloom_fd);
    free(db);
}

/* ═══ Escrever registro ═══ */
static int yodadb_write(YodaDB *db, uint32_t worker_id, uint8_t health,
                        const uint8_t *payload, uint32_t payload_len) {
    uint8_t header[HEADER_SIZE];
    uint64_t timestamp = (uint64_t)time(NULL) * 1000000000ULL;
    
    header[0] = MAGIC_BYTE;
    write_u64_be(header + 1, timestamp);
    write_u32_be(header + 9, worker_id);
    header[13] = health;
    write_u32_be(header + 14, payload_len);
    
    int64_t record_offset = db->current_offset;
    
    /* Escrever header + payload */
    if (write(db->storage_fd, header, HEADER_SIZE) != HEADER_SIZE) return -1;
    if (write(db->storage_fd, payload, payload_len) != (ssize_t)payload_len) return -1;
    
    db->current_offset += HEADER_SIZE + payload_len;
    
    /* Indexar primeira coluna na B-tree */
    const uint8_t *tab = memchr(payload, '\t', payload_len);
    const uint8_t *nl = memchr(payload, '\n', payload_len);
    size_t key_len = payload_len;
    if (tab) key_len = tab - payload;
    if (nl && (size_t)(nl - payload) < key_len) key_len = nl - payload;
    
    if (key_len > 0) {
        uint8_t offset_bytes[8];
        write_u64_be(offset_bytes, (uint64_t)record_offset);
        
        if (!kyber_btree_put(db->kyber, payload, key_len, offset_bytes, 8)) {
            fprintf(stderr, "⚠️  Falha ao indexar chave: %s\n", kyber_btree_last_error());
        }
    }
    
    db->ingested++;
    return 0;
}

/* ═══ Buscar registro ═══ */
static int yodadb_get(YodaDB *db, const void *key, size_t key_len,
                      uint8_t **payload, uint32_t *payload_len) {
    void *offset_val = NULL;
    size_t offset_len = 0;
    
    if (!kyber_btree_get(db->kyber, key, key_len, &offset_val, &offset_len)) {
        return -1;  /* Chave não encontrada */
    }
    
    if (offset_len != 8) {
        free(offset_val);
        return -1;
    }
    
    int64_t offset = (int64_t)read_u64_be(offset_val);
    free(offset_val);
    
    /* Ler header */
    uint8_t header[HEADER_SIZE];
    if (pread(db->storage_fd, header, HEADER_SIZE, offset) != HEADER_SIZE) {
        return -1;
    }
    
    if (header[0] != MAGIC_BYTE) {
        fprintf(stderr, "❌ Magic byte inválido em offset %lld\n", (long long)offset);
        return -1;
    }
    
    uint32_t plen = read_u32_be(header + 14);
    if (plen > 100 * 1024 * 1024) {
        fprintf(stderr, "❌ Payload size absurdo: %u\n", plen);
        return -1;
    }
    
    /* Ler payload */
    uint8_t *buf = malloc(plen);
    if (!buf) return -1;
    
    if (pread(db->storage_fd, buf, plen, offset + HEADER_SIZE) != (ssize_t)plen) {
        free(buf);
        return -1;
    }
    
    *payload = buf;
    *payload_len = plen;
    return 0;
}

/* ═══ Ingestão do stdin ═══ */
static int yodadb_ingest(YodaDB *db, uint32_t worker_id) {
    char *line = NULL;
    size_t line_cap = 0;
    ssize_t line_len;
    uint64_t count = 0;
    
    while ((line_len = getline(&line, &line_cap, stdin)) != -1) {
        /* Remover newline final se presente */
        if (line_len > 0 && line[line_len - 1] == '\n') {
            line_len--;
        }
        if (line_len == 0) continue;
        
        if (yodadb_write(db, worker_id, 100, (uint8_t*)line, (uint32_t)line_len) != 0) {
            fprintf(stderr, "❌ Falha ao escrever registro %llu\n", (unsigned long long)count);
            free(line);
            return -1;
        }
        
        count++;
        if (count % 10000 == 0) {
            fprintf(stderr, "   ... %llu registros ingeridos\n", (unsigned long long)count);
        }
    }
    
    free(line);
    fprintf(stderr, "✅ %llu registros ingeridos com sucesso\n", (unsigned long long)count);
    return 0;
}

/* ═══ Main ═══ */
int main(int argc, char **argv) {
    if (argc < 2) {
        printf("YodaDB v10 — C puro, sem Go/CGO ⚔️\n\n");
        printf("Uso:\n");
        printf("  cat dados.tsv | yodadb put [worker_id]  -> Ingestão\n");
        printf("  yodadb get <key>                        -> Busca\n");
        printf("  yodadb stats                            -> Estatísticas\n");
        return 0;
    }
    
    const char *storage_path = "yoda_storage.log";
    
    if (strcmp(argv[1], "put") == 0) {
        uint32_t worker_id = 1;
        if (argc > 2) worker_id = (uint32_t)atoi(argv[2]);
        
        YodaDB *db = yodadb_open(storage_path);
        if (!db) return 1;
        
        int ret = yodadb_ingest(db, worker_id);
        yodadb_close(db);
        return ret == 0 ? 0 : 1;
        
    } else if (strcmp(argv[1], "get") == 0) {
        if (argc < 3) {
            fprintf(stderr, "Uso: yodadb get <key>\n");
            return 1;
        }
        
        YodaDB *db = yodadb_open(storage_path);
        if (!db) return 1;
        
        uint8_t *payload = NULL;
        uint32_t payload_len = 0;
        
        if (yodadb_get(db, argv[2], strlen(argv[2]), &payload, &payload_len) == 0) {
            fwrite(payload, 1, payload_len, stdout);
            printf("\n");
            free(payload);
        } else {
            fprintf(stderr, "❌ Chave não encontrada: %s\n", argv[2]);
            yodadb_close(db);
            return 1;
        }
        
        yodadb_close(db);
        return 0;
        
    } else if (strcmp(argv[1], "stats") == 0) {
        YodaDB *db = yodadb_open(storage_path);
        if (!db) return 1;
        
        KyberBTreeStats s;
        if (kyber_btree_stats(db->kyber, &s)) {
            printf("═══════════════════════════════════════════════════════════\n");
            printf("📊 YODADB + KYBERDB STATISTICS\n");
            printf("═══════════════════════════════════════════════════════════\n");
            printf("   Chaves indexadas:     %llu\n", (unsigned long long)s.num_keys);
            printf("   Páginas alocadas:     %llu\n", (unsigned long long)s.num_pages);
            printf("   Profundidade:         %llu\n", (unsigned long long)s.depth);
            printf("   Tamanho arquivo:      %.2f MB\n", s.file_size / (1024.0 * 1024.0));
            printf("═══════════════════════════════════════════════════════════\n");
        }
        
        yodadb_close(db);
        return 0;
        
    } else {
        fprintf(stderr, "❌ Comando desconhecido: %s\n", argv[1]);
        return 1;
    }
}
