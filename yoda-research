#!/usr/bin/env bash
set -e

PIDFILE="/tmp/yodadb-server.pid"
REPORT="yoda_research_report.tsv"
CACHE_FILE=".yoda-research-cache.txt"
IGNORE_FILE=".yoda-ignore"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
RESET='\033[0m'

daemon_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start_daemon() {
    if ! daemon_running; then
        echo -e "${BLUE}🚀 Iniciando daemon...${RESET}"
        ./yodadb-server > /tmp/yodadb-research.log 2>&1 &
        sleep 1
    fi
}

# Construir regex de exclusão a partir do .yoda-ignore
build_exclude_regex() {
    local regex=""
    if [ -f "$IGNORE_FILE" ]; then
        while IFS= read -r pattern; do
            [[ -z "$pattern" || "$pattern" =~ ^[[:space:]]*# ]] && continue
            # Escapar pontos para regex
            pattern=$(echo "$pattern" | sed 's/\./\\./g')
            # Se começa com *, substituir por [^/]* (qualquer caractere exceto /)
            if [[ "$pattern" == \** ]]; then
                pattern="[^/]*${pattern:1}"
            fi
            if [ -z "$regex" ]; then
                regex="$pattern"
            else
                regex="$regex|$pattern"
            fi
        done < "$IGNORE_FILE"
    fi
    echo "$regex"
}

cmd_scan() {
    local dir="${1:-.}"
    local total=0 skipped=0 scanned=0 findings=0

    start_daemon

    echo ""
    echo -e "${BLUE}🔍 ESCANEANDO: $dir${RESET}"
    echo ""

    # Carregar cache local
    declare -A cache_map
    if [ -f "$CACHE_FILE" ]; then
        while IFS= read -r hash; do
            cache_map["$hash"]=1
        done < "$CACHE_FILE"
        echo -e "${GREEN}📦 Cache: ${#cache_map[@]} arquivos conhecidos${RESET}"
    fi

    : > "$REPORT"
    printf "file\tline\tcontent\n" >> "$REPORT"

    # Encontrar arquivos fonte
    local file_list_raw="/tmp/yoda_files_raw_$$.txt"
    local file_list="/tmp/yoda_files_$$.txt"
    
    find "$dir" -type f \( \
        -name "*.c" -o -name "*.h" -o -name "*.py" -o \
        -name "*.sh" -o -name "*.go" -o -name "*.js" \
    \) 2>/dev/null > "$file_list_raw"

    # Filtrar usando .yoda-ignore com grep -v (ROBUSTO!)
    local exclude_regex
    exclude_regex=$(build_exclude_regex)
    
    if [ -n "$exclude_regex" ]; then
        grep -vE "$exclude_regex" "$file_list_raw" > "$file_list" || true
        local raw_count=$(wc -l < "$file_list_raw")
        local filtered_count=$(wc -l < "$file_list")
        echo -e "${YELLOW}🗑️  Excluídos: $((raw_count - filtered_count)) arquivos${RESET}"
    else
        mv "$file_list_raw" "$file_list"
    fi
    
    rm -f "$file_list_raw"

    total=$(wc -l < "$file_list")
    echo -e "   📁 Arquivos fonte: ${total}"
    echo ""

    local batch_puts="/tmp/yoda_batch_$$.tsv"
    : > "$batch_puts"

    while IFS= read -r file; do
        local hash
        hash=$(sha256sum "$file" | cut -d' ' -f1)

        if [[ -n "${cache_map[$hash]}" ]]; then
            skipped=$((skipped + 1))
            continue
        fi

        scanned=$((scanned + 1))

        # Escanear com ripgrep
        while IFS= read -r match; do
            if [ -n "$match" ]; then
                local line_num content
                line_num=$(echo "$match" | cut -d: -f1)
                content=$(echo "$match" | cut -d: -f2-)
                printf "%s\t%s\t%s\n" "$file" "$line_num" "$content" >> "$REPORT"
                findings=$((findings + 1))
            fi
        done < <(rg --line-number --no-filename --fixed-strings --file patterns.security "$file" 2>/dev/null || true)

        printf "scan:%s\t%s\n" "$hash" "$file" >> "$batch_puts"
        cache_map["$hash"]=1
        echo "$hash" >> "$CACHE_FILE"

        if [ $((scanned % 20)) -eq 0 ]; then
            echo -e "   ... ${scanned} escaneados (${findings} achados)"
        fi

    done < "$file_list"

    rm -f "$file_list"

    if [ -s "$batch_puts" ]; then
        cat "$batch_puts" | ./yodadb-client put 1 2>/dev/null || true
        rm -f "$batch_puts"
    fi

    echo ""
    echo -e "${GREEN}📊 RESULTADO${RESET}"
    echo -e "   Total: ${total} | Escaneados: ${scanned} | Pulados: ${skipped}"
    echo -e "   ${RED}Achados: ${findings}${RESET}"
    echo ""

    if [ "$findings" -gt 0 ]; then
        echo -e "   ${YELLOW}Primeiros 5 achados:${RESET}"
        tail -n +2 "$REPORT" | head -5 | while IFS=$'\t' read -r f l c; do
            echo -e "   $f:$l → $c"
        done
    fi
}

cmd_report() {
    [ ! -f "$REPORT" ] && echo "Nenhum relatório." && return
    local count=$(tail -n +2 "$REPORT" | wc -l)
    echo ""
    echo -e "${BLUE}📋 RELATÓRIO (${count} achados)${RESET}"
    tail -n +2 "$REPORT" | head -30 | while IFS=$'\t' read -r f l c; do
        echo -e "   ${RED}$f:$l${RESET} $c"
    done
}

cmd_clean() {
    rm -f "$REPORT" "$CACHE_FILE"
    echo -e "${GREEN}✅ Limpo.${RESET}"
}

case "${1:-}" in
    scan)   cmd_scan "${2:-.}" ;;
    report) cmd_report ;;
    clean)  cmd_clean ;;
    *)      echo "Uso: ./yoda-research scan|report|clean" ;;
esac
